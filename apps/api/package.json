{
  "name": "attendance-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --no-warnings --env-file-if-exists=.env src/server.js",
    "dev": "node --no-warnings --env-file-if-exists=.env --watch src/server.js",
    "migrate:sqlite": "node --no-warnings --env-file-if-exists=.env scripts/migrate-sqlite.js",
    "test": "node --no-warnings --test test/logic.test.js test/api.test.js test/roles.test.js test/extras.test.js test/ui.test.js test/auto.test.js"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.0.1",
    "bcryptjs": "^2.4.3",
    "fastify": "^5.0.0",
    "mongodb": "^7.7.0"
  },
  "devDependencies": {},
  "optionalDependencies": {
    "mongodb-memory-server": "^11.3.0"
  }
}