# MongoDB Atlas: Database > Connect > Drivers > copy the connection string, replace <password>.
# Also allow your IP under Network Access, otherwise the connection times out.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=geowork
PORT=3100
# Any long random string. Changing it signs everyone out.
JWT_SECRET=change-me
